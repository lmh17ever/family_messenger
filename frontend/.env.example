# Базовый URL backend'а (без /api/v1 — префикс добавляется в src/lib/config.ts)
# В Docker SPA обслуживается nginx'ом, API тоже через nginx — используйте домен
# или http://localhost для локальной разработки.
# НЕ указывайте http://backend:8000 — это внутренний hostname Docker, в браузере не работает.
VITE_API_BASE_URL=http://localhost

PUBLIC_S3_BASE_URL=https://storage.clo.ru
PUBLIC_S3_PUBLIC_BUCKET=messenger-public-bucket
