# Базовый URL backend'а (без /api/v1 — префикс добавляется в src/lib/config.ts)
PUBLIC_API_BASE_URL=http://localhost:8000

# Опционально: нужны только для отображения аватарок групповых чатов
# (для аватарок пользователей backend отдаёт готовый avatar_url)
PUBLIC_S3_BASE_URL=http://storage.clo.ru
PUBLIC_S3_PUBLIC_BUCKET=messenger-public-bucket
